[gd_scene format=3]

[ext_resource type="Script" path="res://globalScripts/save_manager.gd" id="1_script"]

[node name="SaveManager" type="Node"]
script = ExtResource("1_script")

[node name="AutosaveTimer" type="Timer" parent="."]
wait_time = 30.0
autostart = true

[connection signal="timeout" from="AutosaveTimer" to="." method="write_save"]
