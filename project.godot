; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectCabbage"
config/version="0.1.0"
run/main_scene="res://worlds/MainStoryWorld.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ProjectCabbage"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07450981, 0.07450981, 0.07450981, 1)
boot_splash/image="res://assets/sprites/ui/splash_screen.png"
config/icon="res://icon.png"
boot_splash/minimum_display_time=2000

[audio]

buses/default_bus_layout="res://ressources/default_bus_layout.tres"

[autoload]

SaveManager="*res://globalScripts/SaveManager.tscn"
Hand="*res://globalScripts/hand.gd"
SteamAchievements="*res://globalScripts/steam_achievements.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/gdmaim/plugin.cfg", "res://addons/safe_resource_loader/plugin.cfg")

[game]

demo=false

[gui]

theme/custom="res://ressources/theme/main_theme.tres"

[input]

fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194342,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://ressources/translations/translations.en.translation", "res://ressources/translations/translations.de.translation", "res://ressources/translations/translations.ru.translation", "res://ressources/translations/translations.zh.translation", "res://ressources/translations/translations.es.translation", "res://ressources/translations/translations.ja.translation", "res://ressources/translations/translations.pt.translation", "res://ressources/translations/translations.pl.translation", "res://ressources/translations/translations.fr.translation", "res://ressources/translations/translations.ko.translation", "res://ressources/translations/translations.tr.translation", "res://ressources/translations/translations.it.translation", "res://ressources/translations/translations.cs.translation", "res://ressources/translations/translations.uk.translation", "res://ressources/translations/game.en.translation", "res://ressources/translations/game.de.translation")

[layer_names]

3d_physics/layer_21="ending_target"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
