[gd_scene format=3]

[ext_resource type="Script" path="res://entities/associate/associate.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://entities/hand/hand_model.tscn" id="2_hand"]
[ext_resource type="Script" path="res://entities/components/sound_cue.gd" id="3_cue"]
[ext_resource type="Script" path="res://entities/components/convertible.gd" id="4_conv"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/cabbage_grab_1.wav" id="sfx_grab_1"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/cabbage_grab_2.wav" id="sfx_grab_2"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/cabbage_grab_3.wav" id="sfx_grab_3"]

[sub_resource type="AudioStreamRandomizer" id="Rand_grab"]
random_pitch = 1.1
random_volume_offset_db = 1.5
streams_count = 3
stream_0/stream = ExtResource("sfx_grab_1")
stream_1/stream = ExtResource("sfx_grab_2")
stream_2/stream = ExtResource("sfx_grab_3")

[node name="Associate" type="Node3D"]
script = ExtResource("1_script")

[node name="Hand" parent="." instance=ExtResource("2_hand")]

[node name="Convertible" type="Node" parent="Hand" groups=["ending_hands"]]
script = ExtResource("4_conv")

[node name="Grab" type="AudioStreamPlayer3D" parent="."]
stream = SubResource("Rand_grab")
volume_db = -3.0
bus = &"SFX"
script = ExtResource("3_cue")
min_interval = 0.1
