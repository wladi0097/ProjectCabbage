tooltip = "Findings (¶): research points from the QA bay. Cards priced in ¶ are paid from here. Tokens on the desk only count once you sweep them in."

[node name="Model" parent="." instance=ExtResource("2_model")]

[node name="Intake" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.305, 0.27, 0)

[node name="Tick" type="AudioStreamPlayer3D" parent="."]
