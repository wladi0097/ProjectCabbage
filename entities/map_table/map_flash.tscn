stream_1/stream = ExtResource("sfx_map_token_swap_2")
stream_2/stream = ExtResource("sfx_map_token_swap_3")

[sub_resource type="TorusMesh" id="FlashRing"]
inner_radius = 0.086
outer_radius = 0.104
rings = 48
ring_segments = 6

[sub_resource type="StandardMaterial3D" id="FlashPaper"]
shading_mode = 0
albedo_color = Color(0.93, 0.94, 0.9, 1)

[node name="MapFlash" type="MeshInstance3D"]
gi_mode = 0
cast_shadow = 0
mesh = SubResource("FlashRing")
surface_material_override/0 = SubResource("FlashPaper")

[node name="Acquire" type="AudioStreamPlayer3D" parent="."]
