[gd_scene format=3]

[ext_resource type="Script" path="res://entities/hand_schedule/handling_sheet.gd" id="1_script"]
[ext_resource type="Theme" path="res://entities/consultant/mandate_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://entities/hand_schedule/schedule_cell.tscn" id="3_cell"]
[ext_resource type="AudioStream" path="res://assets/audio/ui/keyboard_keystroke.wav" id="4_click"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/schedule_sheet_out.wav" id="5_open"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/schedule_sheet_back.wav" id="6_close"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/schedule_stamp_1.wav" id="7_stamp"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/schedule_stamp_2.wav" id="7_stamp_2"]
[ext_resource type="AudioStream" path="res://assets/audio/effects/schedule_clear.wav" id="8_clear"]

[sub_resource type="AudioStreamRandomizer" id="Rand_stamp"]
random_pitch = 1.05
random_volume_offset_db = 1.0
streams_count = 2
stream_0/stream = ExtResource("7_stamp")
stream_1/stream = ExtResource("7_stamp_2")

[sub_resource type="StyleBoxLine" id="Divide"]
color = Color(0.13, 0.14, 0.14, 0.55)
thickness = 2
vertical = true

[node name="Schedule" type="CanvasLayer"]
layer = 2

[node name="Sheet" type="Control" parent="." groups=["blocks_hand"]]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Shade" type="ColorRect" parent="Sheet"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.03, 0.5)

[node name="Paper" type="PanelContainer" parent="Sheet"]
custom_minimum_size = Vector2(980, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"MandatePaper"

[node name="Stack" type="VBoxContainer" parent="Sheet/Paper"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Sheet/Paper/Stack"]
layout_mode = 2

[node name="Title" type="Label" parent="Sheet/Paper/Stack/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MandateTitle"
text = "HANDLING ASSIGNMENT SCHEDULE"

[node name="Close" type="Button" parent="Sheet/Paper/Stack/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
mouse_default_cursor_shape = 2
text = "X"

[node name="Sub" type="Label" parent="Sheet/Paper/Stack"]
layout_mode = 2
theme_type_variation = &"MandateSmall"
text = "Form 9-C, in duplicate. Which hands may touch which cabbages. Click a cabbage to strike it for that column; click again to clear it."
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="Sheet/Paper/Stack"]
layout_mode = 2

[node name="Halves" type="HBoxContainer" parent="Sheet/Paper/Stack"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Lab" type="VBoxContainer" parent="Sheet/Paper/Stack/Halves"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Heading" type="Label" parent="Sheet/Paper/Stack/Halves/Lab"]
layout_mode = 2
theme_type_variation = &"MandateValue"
text = "LAB HANDS"

[node name="Note" type="Label" parent="Sheet/Paper/Stack/Halves/Lab"]
layout_mode = 2
theme_type_variation = &"MandateSmall"
text = "Blue cuff. They throw into the research lab."

[node name="Row" type="HBoxContainer" parent="Sheet/Paper/Stack/Halves/Lab"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Regular" parent="Sheet/Paper/Stack/Halves/Lab/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "regular"
research = true
caption = "PLAIN"
ink = Color(0.33, 0.6, 0.18, 1)
picture_scale = 1.0

[node name="Research" parent="Sheet/Paper/Stack/Halves/Lab/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "research"
research = true
caption = "BLUE"
ink = Color(0.16, 0.62, 0.74, 1)
picture_scale = 1.0

[node name="Mini" parent="Sheet/Paper/Stack/Halves/Lab/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "mini"
research = true
caption = "MINI"
ink = Color(0.33, 0.6, 0.18, 1)
picture_scale = 0.6

[node name="Golden" parent="Sheet/Paper/Stack/Halves/Lab/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "golden"
research = true
caption = "GOLDEN"
ink = Color(0.72, 0.58, 0.2, 1)
picture_scale = 1.0

[node name="Divide" type="VSeparator" parent="Sheet/Paper/Stack/Halves"]
layout_mode = 2
theme_override_styles/separator = SubResource("Divide")

[node name="Hired" type="VBoxContainer" parent="Sheet/Paper/Stack/Halves"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Heading" type="Label" parent="Sheet/Paper/Stack/Halves/Hired"]
layout_mode = 2
theme_type_variation = &"MandateValue"
text = "HIRED HANDS"

[node name="Note" type="Label" parent="Sheet/Paper/Stack/Halves/Hired"]
layout_mode = 2
theme_type_variation = &"MandateSmall"
text = "Grey sleeve. They throw out of the window."

[node name="Row" type="HBoxContainer" parent="Sheet/Paper/Stack/Halves/Hired"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Regular" parent="Sheet/Paper/Stack/Halves/Hired/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "regular"
research = false
caption = "PLAIN"
ink = Color(0.33, 0.6, 0.18, 1)
picture_scale = 1.0

[node name="Research" parent="Sheet/Paper/Stack/Halves/Hired/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "research"
research = false
caption = "BLUE"
ink = Color(0.16, 0.62, 0.74, 1)
picture_scale = 1.0

[node name="Mini" parent="Sheet/Paper/Stack/Halves/Hired/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "mini"
research = false
caption = "MINI"
ink = Color(0.33, 0.6, 0.18, 1)
picture_scale = 0.6

[node name="Golden" parent="Sheet/Paper/Stack/Halves/Hired/Row" instance=ExtResource("3_cell")]
layout_mode = 2
kind = "golden"
research = false
caption = "GOLDEN"
ink = Color(0.72, 0.58, 0.2, 1)
picture_scale = 1.0

[node name="Rule2" type="HSeparator" parent="Sheet/Paper/Stack"]
layout_mode = 2

[node name="Foot" type="Label" parent="Sheet/Paper/Stack"]
layout_mode = 2
theme_type_variation = &"MandateSmall"
text = "This schedule only withholds. Clearances for golden cabbages and the handling of rotten ones are governed elsewhere. Padlocked kinds are added on the projector. You may always handle a cabbage yourself."
autowrap_mode = 3

[node name="Click" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_click")
volume_db = -10.0
bus = &"SFX"

[node name="Open" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_open")
volume_db = -6.0
bus = &"SFX"

[node name="Close" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_close")
volume_db = -8.0
bus = &"SFX"

[node name="Stamp" type="AudioStreamPlayer" parent="."]
stream = SubResource("Rand_stamp")
volume_db = -6.0
bus = &"SFX"

[node name="Clear" type="AudioStreamPlayer" parent="."]
stream = ExtResource("8_clear")
volume_db = -4.0
bus = &"SFX"

[connection signal="button_down" from="Sheet/Paper/Stack/Head/Close" to="Click" method="play"]
